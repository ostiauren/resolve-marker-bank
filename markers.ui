<?xml version='1.0' encoding='utf-8'?>
<interface version="1.3">
  <object class="tk.Toplevel" id="toplevel1">
    <property name="geometry">800x360</property>
    <property name="height">200</property>
    <property name="resizable">both</property>
    <property name="title" translatable="yes">Marker Bank</property>
    <property name="width">200</property>
    <child>
      <object class="ttk.Frame" id="frame_heading" named="True">
        <property name="height">200</property>
        <property name="padding">4</property>
        <property name="width">200</property>
        <layout manager="pack">
          <property name="fill">both</property>
          <property name="side">top</property>
        </layout>
        <child>
          <object class="ttk.Label" id="timeline_label" named="True">
            <property name="font">{Arial} 20 {bold}</property>
            <property name="justify">center</property>
            <property name="takefocus">true</property>
            <property name="text" translatable="yes">label24	</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame_pulldown" named="True">
        <property name="height">200</property>
        <property name="padding">4</property>
        <property name="width">200</property>
        <layout manager="pack">
          <property name="anchor">w</property>
          <property name="fill">both</property>
          <property name="side">top</property>
        </layout>
        <child>
          <object class="ttk.Frame" id="frame3">
            <property name="height">200</property>
            <property name="padding">4</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
            <child>
              <object class="ttk.Label" id="label1">
                <property name="text" translatable="yes">Timeline</property>
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="pygubu.builder.widgets.combobox" id="combobox1">
                <property name="state">normal</property>
                <property name="takefocus">true</property>
                <property name="width">40</property>
                <bind add="" handler="combo_selected" sequence="&lt;&lt;ComboboxSelected&gt;&gt;" />
                <layout manager="pack" />
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame5">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="row">1</property>
            </layout>
            <child>
              <object class="ttk.Label" id="label_bank" named="True">
                <property name="text" translatable="yes">Marker bank</property>
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Combobox" id="combobox2">
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame1">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">3</property>
              <property name="row">1</property>
            </layout>
            <child>
              <object class="ttk.Label" id="bank_label" named="True">
                <property name="text" translatable="yes">bank_label</property>
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame_treeview" named="True">
        <property name="padding">4</property>
        <property name="width">200</property>
        <layout manager="pack">
          <property name="fill">both</property>
          <property name="side">top</property>
        </layout>
        <child>
          <object class="pygubu.builder.widgets.scrollbarhelper" id="scrollbarhelper1">
            <property name="scrolltype">both</property>
            <property name="usemousewheel">false</property>
            <layout manager="pack">
              <property name="expand">true</property>
              <property name="fill">both</property>
              <property name="side">top</property>
            </layout>
            <child>
              <object class="pygubu.builder.widgets.editabletreeview" id="etv">
                <property name="selectmode">extended</property>
                <bind add="" handler="on_cell_edited" sequence="&lt;&lt;TreeviewCellEdited&gt;&gt;" />
                <bind add="" handler="on_editors_unfocused" sequence="&lt;&lt;TreeviewEditorsUnfocused&gt;&gt;" />
                <bind add="" handler="on_inplace_edit" sequence="&lt;&lt;TreeviewInplaceEdit&gt;&gt;" />
                <bind add="True" handler="on_row_selected" sequence="&lt;&lt;TreeviewSelect&gt;&gt;" />
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
                <child>
                  <object class="ttk.Treeview.Column" id="col_number" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="height">140</property>
                    <property name="minwidth">10</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">No.</property>
                    <property name="tree_column">true</property>
                    <property name="visible">true</property>
                    <property name="width">10</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_start" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Start</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">90</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_duration" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Duration</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">90</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_name" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Name	</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">100</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_note" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Note	</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">150</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_color" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Color	</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">30</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Treeview.Column" id="col_custom" named="True">
                    <property name="column_anchor">w</property>
                    <property name="heading_anchor">w</property>
                    <property name="minwidth">20</property>
                    <property name="stretch">true</property>
                    <property name="text" translatable="yes">Custom Data	</property>
                    <property name="tree_column">false</property>
                    <property name="visible">true</property>
                    <property name="width">100</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame_bottom" named="True">
        <property name="height">200</property>
        <property name="padding">4</property>
        <property name="width">200</property>
        <layout manager="pack">
          <property name="fill">both</property>
          <property name="side">bottom</property>
        </layout>
        <child>
          <object class="ttk.Checkbutton" id="checkbutton1">
            <property name="text" translatable="yes">Allow edit</property>
            <property name="variable">boolean:allow_edit</property>
            <layout manager="pack">
              <property name="anchor">w</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
